-- 1. LOGIKA NOCLIP (Klawisz N)
local function startNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    
    noclipConnection = RunService.Stepped:Connect(function()
        if noclipEnabled and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

-- 2. LOGIKA FLY (Klawisz F)
local function startCFrameFly()
    if flyConnection then flyConnection:Disconnect() end
    
    flyConnection = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        if not flyEnabled then
            if flyConnection then flyConnection:Disconnect() flyConnection = nil end
            return
        end

        -- Zatrzymanie grawitacji i opadania postaci
        root.Velocity = Vector3.new(0, 0, 0)
        
        local direction = Vector3.new(0, 0, 0)

        -- Sterowanie WSAD
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + Camera.CFrame.RightVector end
        
        -- Wznoszenie i opadanie (Spacja / Lewy Shift)
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction = direction + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then direction = direction - Vector3.new(0, 1, 0) end

        if direction.Magnitude > 0 then
            root.CFrame = root.CFrame + (direction.Unit * flySpeed)
        end
    end)
end

-- 3. PRZECHWYTYWANIE KLIKNIĘĆ KLAWIATURY (F oraz N)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end -- Ignoruj, gdy piszesz na czacie

    -- Obsługa klawisza F (Fly)
    if input.KeyCode == Enum.KeyCode.E then
        flyEnabled = not flyEnabled
        if flyEnabled then
            sendNotification("Fly Module", "Latanie: WŁĄCZONE (WSAD + Spacja/Shift)")
            startCFrameFly()
        else
            sendNotification("Fly Module", "Latanie: WYŁĄCZONE")
            if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        end
    end

    -- Obsługa klawisza N (Noclip)
    if input.KeyCode == Enum.KeyCode.N then
        noclipEnabled = not noclipEnabled
        if noclipEnabled then
            sendNotification("Noclip Module", "Przenikanie przez ściany: WŁĄCZONE")
            startNoclip()
        else
            sendNotification("Noclip Module", "Przenikanie przez ściany: WYŁĄCZONE")
            if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
        end
    end
end)

